// Grafana Alloy configuration for collecting logs from all Docker containers in balena-home

// Discover Docker containers
discovery.docker "containers" {
  host = sys.env("DOCKER_HOST")
}

// Relabel to add service label based on container name
discovery.relabel "add_service_label" {
  targets = discovery.docker.containers.targets

  // Remove leading slash from container name and set as service label (default)
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/?(.+)"
    target_label  = "service"
    replacement   = "$1"
  }

  // Normalize service name: drop numeric suffixes added by Balena
  // Examples: pstryk_metric_12870316_3735864... -> pstryk_metric
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/?(.*?)_\\d+.*"
    target_label  = "service"
    replacement   = "$1"
  }

  // Also set container label for backwards compatibility (full name)
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/?(.+)"
    target_label  = "container"
    replacement   = "$1"
  }

  // Add environment label
  rule {
    target_label = "environment"
    replacement  = "balena-home"
  }
}

// Collect logs from all Docker containers
loki.source.docker "default" {
  host       = sys.env("DOCKER_HOST")
  targets    = discovery.relabel.add_service_label.output
  forward_to = [loki.write.default.receiver]
}

// Write logs to Loki
loki.write "default" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_LOKI_URL")

    // Grafana Cloud requires authentication
    basic_auth {
      username = sys.env("GRAFANA_CLOUD_LOKI_USERNAME")
      password = sys.env("GRAFANA_CLOUD_API_KEY")
    }
  }
}

// ============================================================================
// OpenTelemetry Traces Configuration
// ============================================================================

// Receive OTLP traces from home-controller
otelcol.receiver.otlp "default" {
  // gRPC endpoint for OTLP traces
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  // HTTP endpoint for OTLP traces
  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces = [otelcol.processor.batch.default.input]
  }
}

// Batch processor to reduce request frequency and improve throughput
otelcol.processor.batch "default" {
  // Send batches every 10 seconds or when 8192 spans are collected
  timeout = "10s"
  send_batch_size = 8192
  send_batch_max_size = 10000

  output {
    traces = [
      otelcol.exporter.otlphttp.grafana_cloud.input,
      otelcol.exporter.otlp.datadog.input,
    ]
  }
}

// Export traces to Datadog Agent (gRPC)
// Note: Both alloy and datadog-agent use network_mode: host
// DataDog listens on ports 14317/14318 to avoid conflict with Alloy's receivers (4317/4318)
otelcol.exporter.otlp "datadog" {
  client {
    endpoint = "localhost:14317"
    tls {
      insecure = true
    }
  }

  // Retry and queue configuration to handle backpressure
  sending_queue {
    enabled = true
    num_consumers = 10
    queue_size = 5000
  }

  retry_on_failure {
    enabled = true
    initial_interval = "1s"
    max_interval = "30s"
    max_elapsed_time = "5m"
  }
}

// Export traces to Grafana Cloud (HTTP)
otelcol.exporter.otlphttp "grafana_cloud" {
  client {
    endpoint = "https://otlp-gateway-prod-us-central-0.grafana.net/otlp"
    auth = otelcol.auth.basic.grafana_cloud.handler
  }
}

// Basic auth for Grafana Cloud OTLP
otelcol.auth.basic "grafana_cloud" {
  username = sys.env("GRAFANA_CLOUD_INSTANCE_ID")
  password = sys.env("GRAFANA_CLOUD_API_KEY")
}
