# Production Environment Variables for Balena Deployment
# Copy this file to .env.prod and fill in your actual values
# IMPORTANT: Never commit .env.prod to git - it contains secrets!

# Prometheus / Grafana Cloud
PROMETHEUS_URL=https://prometheus-blocks-prod-us-central1.grafana.net/api/prom/push
PROMETHEUS_USERNAME=83165
PROMETHEUS_PASSWORD=glc_your_grafana_cloud_api_key_here

# Netatmo API
NETATMO_CLIENT_ID=your_netatmo_client_id_here
NETATMO_CLIENT_SECRET=your_netatmo_client_secret_here
NETATMO_REFRESH_TOKEN=your_netatmo_refresh_token_here

# Pyroscope Profiling
PYROSCOPE_ENABLED=true
PYROSCOPE_SERVER_URL=https://profiles-prod-003.grafana.net
PYROSCOPE_APPLICATION_NAME=home-controller
PYROSCOPE_BASIC_AUTH_USER=192047
PYROSCOPE_BASIC_AUTH_PASSWORD=your_grafana_cloud_api_key_here

# OpenTelemetry
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=home-controller
OTEL_SAMPLING_RATE=1.0
OTEL_METRICS_SAMPLING_RATE=0.25

# Thermostat Control
THERMOSTAT_CONTROL_ENABLED=true
THERMOSTAT_CONTROL_DRY_RUN=false
TEMPERATURE_THRESHOLD=0.2
OVERRIDE_DURATION_MINUTES=10

# Thermostat Control Kill Switches
METRIC_JOB_ENABLED=true
CONTROL_JOB_ENABLED=true
HARD_OVERRIDE_JOB_ENABLED=true

# Power Monitoring
POWER_ENABLED=true
POWER_SCRAPE_URL=http://192.168.25.46/state
POWER_SCRAPE_TIMEOUT=0.99

# Logging
LOG_FORMAT=logfmt
LOG_LEVEL=info

# Cloudflare Tunnel
TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# Scheduler UI
SCHEDULER_UI_ENABLED=true
SCHEDULER_UI_HOST=0.0.0.0
SCHEDULER_UI_PORT=8080

# New Relic
NEW_RELIC_OTLP_ENDPOINT=https://otlp.nr-data.net:4318
NEW_RELIC_LICENSE_KEY=your-new-relic-license-key

# Honeycomb
HONEYCOMB_OTLP_ENDPOINT=https://api.honeycomb.io
HONEYCOMB_API_KEY=your-honeycomb-api-key

# Better Stack
BETTER_STACK_OTLP_ENDPOINT=https://in-otel.logs.betterstack.com
BETTER_STACK_AUTH_HEADER=Bearer your-better-stack-source-token
